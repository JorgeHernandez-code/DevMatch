# Copy this file to `.development.env` (local dev) or `.env` and fill in the values.

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_DATABASE=devmatch

# Auto-create/update tables from entities. Use only in development.
DB_SYNCHRONIZE=true
DB_LOGGING=false

# SERVER
PORT=3000

# ENVIRONMENT
ENV=development
